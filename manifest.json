{
  "manifest_version": 3,
  "name": "AddFree - Ad Blocker",
  "version": "1.0.0",
  "description": "Blocks annoying ads, popups, redirects, cookie banners, and trackers across all websites.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "webNavigation",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_domains",
        "enabled": true,
        "path": "rules/ad_domains.json"
      },
      {
        "id": "tracking_params",
        "enabled": true,
        "path": "rules/tracking_params.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/domains.js",
        "content/antipopup.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/domains.js",
        "content/cosmetic.js"
      ],
      "css": [
        "content/cosmetic.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AddFree",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
